# ──────────────────────────────────────────────────────────────────────────
# TruthLoop — server environment template
# Copy to `.env` and fill in real values. Safe to commit.
# ──────────────────────────────────────────────────────────────────────────

PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ──────────────────────────────────────────────────────────────────────────
# PostgreSQL
# ──────────────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# ──────────────────────────────────────────────────────────────────────────
# Auth — Google OAuth + JWT cookie
# Get credentials: https://console.cloud.google.com/apis/credentials
# Set Authorized redirect URI to:  ${BACKEND_URL}/api/auth/google/callback
# ──────────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

JWT_SECRET=change-me-to-a-random-32-char-string
SESSION_SECRET=change-me-to-a-random-string

# Session cookie domain — leave blank in dev (host-only cookies).
# In prod, set to your shared parent domain, e.g. '.sajjan.dev' if your
# frontend and backend live on subdomains of saijan.dev. MUST NOT be a
# public suffix (e.g. '.onrender.com' is on the PSL — Chrome rejects it).
COOKIE_DOMAIN=

# ──────────────────────────────────────────────────────────────────────────
# Anthropic Claude API
# The wrapper defaults to the MiniMax Anthropic-compatible gateway because
# `MiniMax-M3` is the cheapest tier for the demo. Set ANTHROPIC_BASE_URL to
# `https://api.anthropic.com` to use the real Anthropic API instead.
# Subscription key: https://platform.minimax.io/user-center/payment/token-plan
# ──────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic
ANTHROPIC_DEFAULT_MODEL=MiniMax-M2
ANTHROPIC_STRONG_MODEL=MiniMax-M2.7

# ──────────────────────────────────────────────────────────────────────────
# MiniMax web_search — used by /submit's live fact-check
# Calls POST {MINIMAX_API_HOST}/v1/coding_plan/search with the user's claim
# so Claude can answer from current sources instead of stale training data.
#
# Same Token Plan seat as the LLM gateway above, so the wrapper falls back
# to ANTHROPIC_API_KEY when this is unset — only fill in if you want a
# separate quota/identity for search calls.
# Subscription: https://platform.minimax.io/user-center/payment/token-plan
# ──────────────────────────────────────────────────────────────────────────
MINIMAX_API_KEY=
MINIMAX_API_HOST=https://api.minimax.io

# ──────────────────────────────────────────────────────────────────────────
# Cloudinary (image uploads)
# Get yours: https://cloudinary.com/console
# ──────────────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ──────────────────────────────────────────────────────────────────────────
# Resend (transactional email)
# Get yours: https://resend.com/api-keys
# ──────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# ──────────────────────────────────────────────────────────────────────────
# Scheduled jobs (cron)
# ──────────────────────────────────────────────────────────────────────────
CRON_ENABLED=true
CRON_TIMEZONE=UTC
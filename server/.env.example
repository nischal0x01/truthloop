# ──────────────────────────────────────────────────────────────────────────
# TruthLoop — server environment template
# Copy to `.env` and fill in real values. Safe to commit.
# ──────────────────────────────────────────────────────────────────────────

PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ──────────────────────────────────────────────────────────────────────────
# PostgreSQL
# ──────────────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# ──────────────────────────────────────────────────────────────────────────
# Auth — Google OAuth + JWT cookie
# Get credentials: https://console.cloud.google.com/apis/credentials
# Set Authorized redirect URI to:  ${BACKEND_URL}/api/auth/google/callback
# ──────────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

JWT_SECRET=change-me-to-a-random-32-char-string
SESSION_SECRET=change-me-to-a-random-string

# ──────────────────────────────────────────────────────────────────────────
# Anthropic Claude API
# Get yours: https://console.anthropic.com/
# ──────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-5
ANTHROPIC_STRONG_MODEL=claude-opus-4-1

# ──────────────────────────────────────────────────────────────────────────
# Resend (transactional email)
# Get yours: https://resend.com/api-keys
# ──────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# ──────────────────────────────────────────────────────────────────────────
# Scheduled jobs (cron)
# ──────────────────────────────────────────────────────────────────────────
CRON_ENABLED=true
CRON_TIMEZONE=UTC